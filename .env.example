# LLM Provider Configuration
# Supported providers: "groq", "gemini", "openai", or "auto" (or leave empty for intelligent heuristic fallback)
LLM_PROVIDER=auto

# API Keys (Set whichever provider you want to use)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM Model (optional override)
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Gemini: gemini-3.6-flash
# OpenAI: gpt-4o-mini
LLM_MODEL=

# Database Configuration
# Local default: sqlite:///./examiner.db
# Docker container default: sqlite:////app/data/examiner.db
DATABASE_URL=sqlite:///./examiner.db
